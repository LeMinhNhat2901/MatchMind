# ============================================================
# MatchMind — Football Tactical Intelligence
# Copy this file to .env and fill in your values
# ============================================================

# ── LLM Provider ───────────────────────────────────
# Supported: groq | gemini | openai | anthropic
GROQ_API_KEY=                  # https://console.groq.com/keys  (fastest + free tier)
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=             # optional
OPENAI_API_KEY=                # optional

LLM_PROVIDER=groq              # groq | gemini | openai | anthropic
LLM_MODEL=qwen/qwen3.8-27b   # Groq text model (fast, free)
GROQ_MODEL=qwen/qwen3.8-27b  # Groq text model override
# LLM_MODEL=gemini-2.5-flash        # uncomment to use Gemini
# LLM_MODEL=gpt-4o-mini             # uncomment to use OpenAI

# ── Vector Store ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./tactics_db
CHROMA_COLLECTION_NAME=football_tactics

# ── Embedding Model ────────────────────────────────────
# Runs locally (no API cost).
# chroma_default = ChromaDB ONNX EF (recommended, avoids Python 3.13 crash)
# sentence_transformers = use sentence-transformers directly
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BACKEND=chroma_default

# ── Databases (Phase 2 — not needed for MVP) ────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://matchmind:matchmind@localhost:5432/matchmind

# ── Agent Config ────────────────────────────────────────────
AGENT_MAX_RETRIES=2
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35   # fallback; scripts/calibrate_retrieval.py overrides
RETRIEVAL_TOP_K=3
RETRIEVAL_PHASE_FILTER=true           # pre-filter KB by phase_of_play on first retrieve

# ── Paths ────────────────────────────────────────────────────
KNOWLEDGE_BASE_DIR=./matchmind/knowledge_base/concepts
PITCH_IMAGES_DIR=./output/pitch_images
EVALUATION_OUTPUT_DIR=./output/evaluation

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
