# ============================================================
# MatchMind — Football Tactical Intelligence
# Copy this file to .env and fill in your values
# ============================================================

# ── LLM Providers ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=                # optional — only if LLM_PROVIDER=openai. Embeddings run locally.

# LLM model selection — check skills/skills/claude-api for current model ids
LLM_PROVIDER=anthropic         # anthropic | openai
LLM_MODEL=claude-sonnet-4-5    # anthropic model id | gpt-4o

# ── Vector Store ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./tactics_db
CHROMA_COLLECTION_NAME=football_tactics

# ── Embedding Model ─────────────────────────────────────────
# "all-MiniLM-L6-v2" (English, fast)
# "intfloat/multilingual-e5-base" (multilingual, better for Vietnamese)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Databases (Phase 2 — not needed for MVP) ────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://matchmind:matchmind@localhost:5432/matchmind

# ── Agent Config ────────────────────────────────────────────
AGENT_MAX_RETRIES=2
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35   # fallback; scripts/calibrate_retrieval.py overrides
RETRIEVAL_TOP_K=3
RETRIEVAL_PHASE_FILTER=true           # pre-filter KB by phase_of_play on first retrieve

# ── Paths ────────────────────────────────────────────────────
KNOWLEDGE_BASE_DIR=./matchmind/knowledge_base/concepts
PITCH_IMAGES_DIR=./output/pitch_images
EVALUATION_OUTPUT_DIR=./output/evaluation

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
